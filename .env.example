# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Process timezone. "Today" defaults and the nightly cron date filter use local
# time, while stored attendance dates use Asia/Kolkata.
TZ=Asia/Kolkata

# FFmpeg binary. Use an absolute path if ffmpeg is not on PATH.
FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# MongoDB
# MongoDB must run as a replica set: presence writes use transactions.
# MONGO_DB_URL must not include the database name; the app appends it.
# ---------------------------------------------------------------------------
MONGO_DB_URL=mongodb://localhost:27017
MONGO_DB_REPLICA_SET=rs0
MONGO_DBNAME=live_face_tracker

# ---------------------------------------------------------------------------
# Authentication
# Values for the *_MAX_AGE variables use the `ms` duration format (15m, 7d).
# PYTHON_JWT_SECRET verifies service tokens sent by the AI worker.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_MAX_AGE=15m
JWT_REFRESH_TOKEN_MAX_AGE=7d
PYTHON_JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Redis (cache, pub/sub, streams, BullMQ)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object storage
# The bucket must exist; it is not created automatically.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_EMPLOYEE_BUCKET_NAME=live-face-tracker

# ---------------------------------------------------------------------------
# External AI / embedding service
# EMBEDDING_API_URL receives multipart uploads under the `files` field.
# The match/promote endpoints are used by POST /api/v1/employees/promote.
# ---------------------------------------------------------------------------
EMBEDDING_API_URL=http://localhost:8195
UNKNOWN_MATCH_WITH_EXISTING_API_URL=http://localhost:8195/match
UNKNOWN_PROMOTE_API_URL=http://localhost:8195/promote

# ---------------------------------------------------------------------------
# LiveKit
# LIVEKIT_INGRESS_HOST is the LiveKit server used by the Ingress API.
# LIVEKIT_URL is the public signaling URL the browser connects to (wss://).
# ---------------------------------------------------------------------------
LIVEKIT_INGRESS_HOST=ws://localhost:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_TOKEN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Camera health watchdog
# Both values are milliseconds.
# ---------------------------------------------------------------------------
WATCHDOG_INTERVAL=3000
OFFLINE_THRESHOLD=5000

# ---------------------------------------------------------------------------
# Presence and attendance
# Duration values accept `ms`-style strings: 30s, 5m, 3h.
# Office hours use 24-hour HH:mm format.
# EXIT_TIMEOUT_AFTER_ENTRY_GATE is parsed at boot and reserved for the
# entry-gate flow; the active exit timer uses EXIT_TIMEOUT_AFTER_EXIT_GATE.
# ---------------------------------------------------------------------------
EXIT_TIMEOUT_AFTER_EXIT_GATE=45s
EXIT_TIMEOUT_AFTER_ENTRY_GATE=3h
OFFICE_START_TIME=09:00
OFFICE_END_TIME=21:00

# ---------------------------------------------------------------------------
# Uploads (sizes in MB)
# ---------------------------------------------------------------------------
EMPLOYEE_IMAGE_MAX_COUNT=10
EMPLOYEE_IMAGE_MAX_SIZE=5
UNKNOWN_IMAGE_MAX_COUNT=20
UNKNOWN_IMAGE_MAX_SIZE=5

# ---------------------------------------------------------------------------
# Debugging
# When true, unknown-face uploads are mirrored to debug_node_images/.
# ---------------------------------------------------------------------------
NODE_DEBUG_UNKNOWN_IMAGES=false
